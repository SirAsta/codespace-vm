{
  // Default configuration: Ubuntu with Docker sidecar support.
  // Alternatives live in .devcontainer/<arch|fedora|debian>/ — choose one from
  // the "Dev container configuration" dropdown on the codespace creation page.
  "name": "Linux VM (KDE Plasma + noVNC)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // Provides Docker inside the Codespace so sidecar distro containers can run.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode",
      "userUid": 1000,
      "userGid": 1000
    }
  },

  "remoteUser": "vscode",

  // Default settings. Codespaces Secrets and shell exports take precedence.
  "remoteEnv": {
    "VNC_PASSWORD": "vscode",
    "RESOLUTION": "1600x900",
    "VNC_DISPLAY": ":1"
  },

  "forwardPorts": [6080, 5901, 3001, 3002, 3003, 3004, 3005, 3006],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "openPreview"
    },
    "5901": {
      "label": "VNC (native client)",
      "onAutoForward": "silent"
    },
    "3001": { "label": "sidecar ubuntu", "onAutoForward": "silent" },
    "3002": { "label": "sidecar debian", "onAutoForward": "silent" },
    "3003": { "label": "sidecar arch", "onAutoForward": "silent" },
    "3004": { "label": "sidecar fedora", "onAutoForward": "silent" },
    "3005": { "label": "sidecar alpine", "onAutoForward": "silent" },
    "3006": { "label": "extra (kali/custom)", "onAutoForward": "silent" }
  },

  // Start the desktop after creation and again on every Codespace start.
  "postCreateCommand": "bash .devcontainer/start-vnc.sh",
  "postStartCommand": "bash .devcontainer/start-vnc.sh",
  "postAttachCommand": "bash scripts/status.sh || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "10gb",
    "storage": "64gb"
  }
}
