{
  // Arch Linux configuration: rolling-release Arch booting straight into KDE Plasma.
  // Select "arch" from the "Dev container configuration" dropdown on the
  // codespace creation page (Code -> Codespaces -> ... -> New with options).
  // Shares the VNC scripts in .devcontainer/ through build context "..".
  // Note: Docker is not installed here, so sidecar containers are unavailable.
  // Use the default Ubuntu configuration when you need sidecars.
  "name": "arch",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "remoteUser": "vscode",

  // Default settings. Codespaces Secrets and shell exports take precedence.
  "remoteEnv": {
    "VNC_PASSWORD": "vscode",
    "RESOLUTION": "1600x900",
    "VNC_DISPLAY": ":1"
  },

  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "openPreview"
    },
    "5901": {
      "label": "VNC (native client)",
      "onAutoForward": "silent"
    }
  },

  // Start the desktop after creation and again on every Codespace start.
  "postCreateCommand": "bash .devcontainer/start-vnc.sh",
  "postStartCommand": "bash .devcontainer/start-vnc.sh",
  "postAttachCommand": "bash scripts/status.sh || true",

  // Minimum machine specification. Kept at the smallest standard Codespace
  // size so creation is never blocked; choose a 4-core machine on the
  // creation page for the best Plasma experience.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
