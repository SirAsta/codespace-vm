{
  // Alternate configuration that boots the main desktop straight into KDE Plasma.
  // Select "Linux VM (KDE Plasma + noVNC)" when creating the Codespace.
  // Fallback: copy this file over .devcontainer/devcontainer.json and rebuild.
  "name": "Linux VM (KDE Plasma + noVNC)",
  "build": {
    "dockerfile": "../Dockerfile.kde",
    "context": ".."
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode",
      "userUid": 1000,
      "userGid": 1000
    }
  },

  "remoteUser": "vscode",

  "remoteEnv": {
    "VNC_PASSWORD": "vscode",
    "RESOLUTION": "1600x900",
    "VNC_DISPLAY": ":1",
    "DESKTOP": "kde"
  },

  "forwardPorts": [6080, 5901, 3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008, 3009, 3010, 3011],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "openPreview"
    },
    "5901": {
      "label": "VNC (native client)",
      "onAutoForward": "silent"
    },
    "3001": { "label": "webtop ubuntu xfce", "onAutoForward": "silent" },
    "3002": { "label": "webtop debian xfce", "onAutoForward": "silent" },
    "3003": { "label": "webtop arch xfce", "onAutoForward": "silent" },
    "3004": { "label": "webtop fedora xfce", "onAutoForward": "silent" },
    "3005": { "label": "webtop alpine xfce", "onAutoForward": "silent" },
    "3006": { "label": "webtop ubuntu kde", "onAutoForward": "silent" },
    "3007": { "label": "webtop debian kde", "onAutoForward": "silent" },
    "3008": { "label": "webtop arch kde", "onAutoForward": "silent" },
    "3009": { "label": "webtop fedora kde", "onAutoForward": "silent" },
    "3010": { "label": "webtop alpine kde", "onAutoForward": "silent" },
    "3011": { "label": "extra (kali/custom)", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/start-vnc.sh",
  "postStartCommand": "bash .devcontainer/start-vnc.sh",
  "postAttachCommand": "bash scripts/status.sh || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "10gb",
    "storage": "64gb"
  }
}
